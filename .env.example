# Sponsor model gateway — server only. Get key: https://nicrron.ai/dashboard/keys
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=nicrron/auto
NICRRON_WEB_MODEL=openai/gpt-4.1-mini
# PRISM live HTTP instrumentation — server only. Never prefix these with NEXT_PUBLIC_.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://api.prism.blockconvey.com
PRISM_AGENT_ID=firstcheque-analyst
# New web research is isolated under firstcheque-web-analyst in PRISM.
# Optional search keys. Without a key, Tavily keyless search is rate limited.
TAVILY_API_KEY=
EXA_API_KEY=
# Private Vercel Blob library, linked to development + preview.
# Without this, local development stores dossiers under ignored work/company-library/.
# A Vercel deployment requires shared storage to save reports.
BLOB_READ_WRITE_TOKEN=
